# Copy to frontend/.env if you need to override defaults. No secrets belong in this file —
# everything prefixed VITE_ is bundled into the public JavaScript.

# Where the Vite dev server proxies /api (see vite.config.ts). Change if the API runs elsewhere.
# VITE_API_PROXY_TARGET=http://localhost:5000

# Production only: the API's own origin (no trailing slash, no /api). Leave unset in development so the
# Vite proxy above is used and cookies stay first-party.
# VITE_API_URL=https://api.test.uttargujaratpatidar.in
