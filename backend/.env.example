# Copy to backend/.env and adjust. Never commit the real .env file.

NODE_ENV=development
PORT=5000

# Browser origin allowed by CORS (the Vite dev server by default).
CLIENT_ORIGIN=http://localhost:5173

# Local MongoDB (no credentials in development). In production use a dedicated
# least-privilege database user and never expose MongoDB to the public internet.
MONGO_URI=mongodb://127.0.0.1:27018/patidar_samaj

# Generate a long random value, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production refuses to start with a short or placeholder secret.
SESSION_SECRET=change-me-development-only-secret-0000000000

# Where uploaded files are stored. Keep it OUTSIDE any web-served folder and back it up with the database.
# UPLOAD_DIR=uploads

# Optional tuning (defaults shown)
# SESSION_COOKIE_NAME=samaj.sid
# CSRF_COOKIE_NAME=samaj.csrf
# SESSION_TTL_HOURS=12
# SESSION_IDLE_MINUTES=60
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=10
# TRUST_PROXY=false        # set to true behind a reverse proxy

# Development-only sample data. Ignored and refused when NODE_ENV=production.
ENABLE_DEV_SEED=false
